# Copy this file to secrets.yaml and fill in your values.
# Do not commit secrets.yaml to git.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback password for the ESP32 captive portal AP (min 8 chars)
ap_password: "setup1234"

# Generate with: esphome run dimplex-fireplace.yaml  (ESPHome generates one on first compile)
# Or use https://esphome.io/components/api.html#configuration-variables
api_encryption_key: "GENERATE_A_32_BYTE_BASE64_KEY"

# Separate key for dimplex-ble-dump.yaml (second ESP32)
dump_api_encryption_key: "GENERATE_A_32_BYTE_BASE64_KEY"

# Bluetooth MAC address of your fireplace.
# Find it via nRF Connect, Home Assistant Bluetooth integration, or ESPHome logs while scanning.
fireplace_mac: "AA:BB:CC:DD:EE:FF"

# 6-digit PIN from the sticker inside the fireplace (lift the bottom front panel).
# Same PIN used by the Flame Connect app during initial pairing.
fireplace_pin: 123456
